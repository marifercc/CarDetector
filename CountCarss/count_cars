import cv2
import torch

def load_model():
    model = torch.hub.load("ultralytics/yolov5", model="yolov5n", pretrained=True)
    return model

def get_bboxes(preds: object): # Corregido typo de 'prends' a 'preds'
    df = preds.pandas().xyxy[0] 
    df = df[df["confidence"] >= 0.5] 
    df = df[df["name"] == "car"] 

    # Retorna las coordenadas como un array de enteros
    return df[["xmin", "ymin", "xmax", "ymax"]].values.astype(int)

def detector(cap: object):
    model = load_model()

    while cap.isOpened():
        status, frame = cap.read()
        if not status:
            break

        preds = model(frame)
        bboxes = get_bboxes(preds)

        # DIBUJAR LOS RECTÁNGULOS 
        for box in bboxes:
            xmin, ymin, xmax, ymax = box
            # cv2.rectangle(imagen, punto_inicio, punto_fin, color(BGR), grosor)
            cv2.rectangle(frame, (xmin, ymin), (xmax, ymax), (0, 255, 0), 2)

        print(f"Carros detectados en este frame: {len(bboxes)}")

        # MOSTRAR EL VIDEO
        cv2.imshow("frame", frame)

        # Importante: waitKey(1) para que el video corra fluido
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

    cap.release()
    cv2.destroyAllWindows()

if __name__ == '__main__':
    cap = cv2.VideoCapture("data/traffic.mp4")
    detector(cap)