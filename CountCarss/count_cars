import cv2

def detector(video_source: str) -> None:
    """Función para mostrar frames de un video hasta que se presione 'q'."""
    
    cap = cv2.VideoCapture(video_source)

    if not cap.isOpened():
        print("Error: No se pudo abrir el video.")
        return

    while True:
        status, frame = cap.read()
        if not status:
            print("Fin del video o error al leer frame.")
            break

        cv2.imshow("Frame", frame)

        # Espera 10 ms y verifica si se presionó 'q'
        if cv2.waitKey(10) & 0xFF == ord('q'):
            print("Detenido por el usuario.")
            break
    
    cap.release()
    cv2.destroyAllWindows()


if __name__ == "__main__":
    detector("data/traffic.mp4")
