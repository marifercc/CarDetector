import cv2
import torch

def load_model():
    model = torch.hub.load("ultralytics/yolov5", model="yolov5n", pretrained=True)
    return model

def get_bboxes(prends: object):
    #xmin, ymin, xmax, ymax 
    df = prends.pandas().xyxy[0] # las predicciones las ponemos en formato pandas en fomrato de bounding boxes 
    df = df[df["confidence"] >= 0.5] # solo los que esté mayor a .5 
    df = df [df["name"] == "car"] # unicamente carros

    return df[["xmin", "ymin", "xmax", "ymax"]].values.astype(int)

def detector(cap: object):

    model = load_model()

    while cap.isOpened():
        status, frame = cap.read()
        if not status:
            break

        preds = model(frame)
        bboxes = get_bboxes(preds)
        print(bboxes)
        break

        # cv2.imshow("frame", frame)

        # if cv2.waitKey(10) & 0xFF == ord('q'):
        #     break

    cap.release()

if __name__ == '__main__':

    cap = cv2.VideoCapture("data/traffic.mp4")
    detector(cap)