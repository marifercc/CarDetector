import cv2
import torch
import numpy as np
import matplotlib.path as mplPath

# 1. Definimos la zona de detección
ZONE = np.array([
    [333, 374], [403, 470], [476, 655], [498, 710],
    [1237, 714], [1217, 523], [1139, 469], [1009, 393],
], np.int32)

def load_model():
    return torch.hub.load("ultralytics/yolov5", model="yolov5n", pretrained=True)

def get_center(bbox):
    # bbox llega como [xmin, ymin, xmax, ymax]
    xc = (int(bbox[0]) + int(bbox[2])) // 2
    yc = (int(bbox[1]) + int(bbox[3])) // 2
    return xc, yc

def get_detections(preds):
    """Filtra detecciones por confianza y clases específicas"""
    df = preds.pandas().xyxy[0] 
    # Clases: car, bus, motorcycle (etiquetas estándar de COCO)
    clases_objetivo = ['car', 'bus', 'motorcycle']
    df = df[(df["confidence"] >= 0.4) & (df["name"].isin(clases_objetivo))]
    
    # Retornamos coordenadas + el nombre de la clase
    return df[["xmin", "ymin", "xmax", "ymax", "name"]].values

def is_valid_detection(xc, yc): 
    return mplPath.Path(ZONE).contains_point((xc, yc))

def detector(cap):
    model = load_model()
    
    # --- DICCIONARIOS PARA CONTADORES TOTALES ---
    totales = {'car': 0, 'bus': 0, 'motorcycle': 0}
    memoria_ids = {'car': [], 'bus': [], 'motorcycle': []}
    # --------------------------------------------

    while cap.isOpened():
        status, frame = cap.read()
        if not status: break

        preds = model(frame)
        detecciones = get_detections(preds)

        for det in detecciones:
            xmin, ymin, xmax, ymax, etiqueta = det
            xc, yc = get_center([xmin, ymin, xmax, ymax])
            
            if is_valid_detection(xc, yc):
                # Lógica de conteo histórico por categoría
                es_nuevo = True
                for old_center in memoria_ids[etiqueta]:
                    distancia = np.linalg.norm(np.array([xc, yc]) - np.array(old_center))
                    if distancia < 35: # Umbral de pixeles para seguimiento
                        es_nuevo = False
                        memoria_ids[etiqueta].remove(old_center)
                        memoria_ids[etiqueta].append([xc, yc])
                        break
                
                if es_nuevo:
                    totales[etiqueta] += 1
                    memoria_ids[etiqueta].append([xc, yc])

                color = (0, 255, 0) # Verde si está en zona
            else:
                color = (0, 0, 255) # Rojo si está fuera

            # Dibujar en el frame
            cv2.rectangle(frame, (int(xmin), int(ymin)), (int(xmax), int(ymax)), color, 2)
            cv2.putText(frame, etiqueta, (int(xmin), int(ymin)-10), 
                        cv2.FONT_HERSHEY_SIMPLEX, 0.5, color, 2)

        # Limpiar memoria vieja para no saturar
        for k in memoria_ids:
            if len(memoria_ids[k]) > 30: memoria_ids[k].pop(0)

        # --- INTERFAZ DE USUARIO (HUD) ---
        # Dibujar polígono de zona
        cv2.polylines(frame, [ZONE], True, (255, 255, 255), 2)
        
        # Panel de control (Fondo negro)
        cv2.rectangle(frame, (20, 20), (380, 180), (0, 0, 0), -1)
        
        # Textos de contadores
        # Usamos colores diferentes para cada uno
        cv2.putText(frame, f"TOTAL HISTORICO:", (40, 50), 0, 0.7, (255,255,255), 2)
        cv2.putText(frame, f"Carros: {totales['car']}", (40, 85), 0, 0.8, (0, 255, 0), 2)
        cv2.putText(frame, f"Buses:  {totales['bus']}", (40, 120), 0, 0.8, (0, 255, 255), 2)
        cv2.putText(frame, f"Motos:  {totales['motorcycle']}", (40, 155), 0, 0.8, (255, 100, 0), 2)

        cv2.imshow("Monitor de Trafico Inteligente", frame)

        if cv2.waitKey(1) & 0xFF == ord('q'): break

    cap.release()
    cv2.destroyAllWindows()

if __name__ == '__main__':
    cap = cv2.VideoCapture("data/traffic.mp4")
    detector(cap)