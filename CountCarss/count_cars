import cv2
import torch
import numpy as np
import matplotlib.path as mplPath

# 1. Definimos la zona
ZONE = np.array([
    [333, 374], [403, 470], [476, 655], [498, 710],
    [1237, 714], [1217, 523], [1139, 469], [1009, 393],
], np.int32)

def load_model():
    return torch.hub.load("ultralytics/yolov5", model="yolov5n", pretrained=True)

def get_center(bbox):
    xc = (bbox[0] + bbox[2]) // 2
    yc = (bbox[1] + bbox[3]) // 2
    return xc, yc

def get_bboxes(preds):
    df = preds.pandas().xyxy[0] 
    df = df[(df["confidence"] >= 0.5) & (df["name"] == "car")]
    return df[["xmin", "ymin", "xmax", "ymax"]].values.astype(int)

def is_valid_detection(xc, yc): 
    return mplPath.Path(ZONE).contains_point((xc, yc))

def detector(cap):
    model = load_model()
    
    # --- VARIABLES PARA EL CONTADOR TOTAL ---
    total_cars_count = 0
    ids_en_zona = [] # Guardaremos los centros de los carros para "recordarlos"
    # ----------------------------------------

    while cap.isOpened():
        status, frame = cap.read()
        if not status: break

        preds = model(frame)
        bboxes = get_bboxes(preds)

        current_detections = 0
        current_centers = []

        for box in bboxes:
            xc, yc = get_center(box)
            
            if is_valid_detection(xc, yc):
                current_detections += 1
                
                # LÓGICA DE CONTEO TOTAL SIMPLIFICADA:
                # Si el centro del carro no está cerca de uno que ya contamos, es nuevo
                es_nuevo = True
                for old_center in ids_en_zona:
                    # Calculamos distancia entre el punto actual y los viejos
                    distancia = np.linalg.norm(np.array([xc, yc]) - np.array(old_center))
                    if distancia < 30: # Si está a menos de 30 pixeles, es el mismo carro
                        es_nuevo = False
                        # Actualizamos la posición del carro viejo
                        ids_en_zona.remove(old_center)
                        ids_en_zona.append([xc, yc])
                        break
                
                if es_nuevo:
                    total_cars_count += 1
                    ids_en_zona.append([xc, yc])

                color = (0, 255, 0)
            else:
                color = (0, 0, 255)

            # Dibujo
            cv2.circle(frame, (xc, yc), 5, color, -1)
            cv2.rectangle(frame, (box[0], box[1]), (box[2], box[3]), color, 2)

        # Limpiar la lista de IDs para no saturar la memoria (opcional)
        if len(ids_en_zona) > 50: ids_en_zona.pop(0)

        # --- INTERFAZ ---
        # Polígono de zona
        cv2.polylines(frame, [ZONE], True, (255, 255, 255), 2)
        
        # Cuadro de información
        cv2.rectangle(frame, (50, 40), (450, 160), (0, 0, 0), -1)
        cv2.putText(frame, f"En zona: {current_detections}", (70, 90), 
                    cv2.FONT_HERSHEY_SIMPLEX, 1.2, (0, 255, 0), 2)
        cv2.putText(frame, f"Total histórico: {total_cars_count}", (70, 140), 
                    cv2.FONT_HERSHEY_SIMPLEX, 1.2, (255, 255, 255), 2)

        cv2.imshow("Control de Trafico", frame)

        if cv2.waitKey(1) & 0xFF == ord('q'): break

    cap.release()
    cv2.destroyAllWindows()

if __name__ == '__main__':
    cap = cv2.VideoCapture("data/traffic.mp4")
    detector(cap)