import cv2 #abirir video
import numpy as np #matrices y operaciones matemáticas
import matplotlib.path as mplPath #ver si centroide está dentro de la zona de conteo
from ultralytics import YOLO #importar modelo de yolo
from boxmot.trackers.bbox.ocsort import OcSort #para motos: bueno reconectando objetos rapidos que se pierden
from boxmot.trackers.bbox.bytetrack import ByteTrack #para car/bus/truck: es el que ya dio el conteo correcto (28/1)
import csv #usar csv para reporte final
import os #abrir rutas de archivos
import sys # permitir que python acceda a los argumentos de los comandos

# --- DEFINE LAS COORDENADAS DE LA ZONA ---
COORD_ZONA_A = np.array([ #camibio a solo 1 punto de encuentro
    [400, 280],   
    [750, 280],  
    [1100, 450],  
    [1100, 720], 
    [600, 720],   
    [300, 500],  
], np.int32)

def detector(video_path):
    ruta_base = os.path.dirname(os.path.abspath(__file__))
    video_full_path = video_path if os.path.isabs(video_path) else os.path.join(ruta_base, video_path)
    print(f"Abriendo video: {video_full_path}")
    model = YOLO("yolo11x.pt") #CAMBIO A X PARA MEJOR PRECISIÓN
    cap = cv2.VideoCapture(video_full_path)
    if not cap.isOpened():
        raise FileNotFoundError(f"No se pudo abrir el video: {video_full_path}")

    fps = cap.get(cv2.CAP_PROP_FPS)
    w_out, h_out = 1280, 720 # si se le cambia acá rompe el video de dimensiones

    video_writer = cv2.VideoWriter(
        os.path.join(ruta_base, "resultado_procesado_ocsort_TEST.mp4"),
        cv2.VideoWriter_fourcc(*'mp4v'),
        fps, (w_out, h_out)
    )

    # HIBRIDO: un tracker por grupo de clases, cada uno en lo que ya sabemos que
    # rinde bien (medido, no adivinado): ByteTrack para car/bus/truck (dio el 28/1
    # correcto), OC-SORT solo para motos (dio el 2 correcto, el numero real
    # confirmado a simple vista en el video). Asi no hay que elegir una sola
    # configuracion que le sirva a la vez a autos (lentos, cajas grandes) y motos
    # (rapidas, cajas angostas) -- que fue justo lo que fallo con BoT-SORT y con
    # OC-SORT solo (mejoraban motos pero fusionaban autos distintos entre si).
    byte_tracker = ByteTrack(track_thresh=0.1, match_thresh=0.4, track_buffer=60, frame_rate=int(round(fps)))
    oc_tracker = OcSort(det_thresh=0.3, max_age=30, min_hits=1, iou_threshold=0.3)
    path_a = mplPath.Path(COORD_ZONA_A)

    ids_contados_a = set()
    # el ID que da el tracker de YOLO es global a todo el video (sube con cualquier
    # objeto detectado, entre o no a la zona); acá se guarda un número propio y
    # secuencial solo para los vehículos que sí entran a la zona, en orden de entrada
    numero_contado = {}
    total_contados = 0  # contador real de vehículos únicos (no cuenta los IDs fusionados)
    clase_contado = {}  # numero de conteo -> nombre de clase (car/motorcycle/truck/bus), para el desglose final

    # el tracker (ByteTrack) a veces "pierde" un objeto por 1-2 frames y le da un ID
    # nuevo al reaparecer (típico en motos: cajas angostas + movimiento rápido ->
    # el solapamiento entre frames cae por debajo del match_thresh). En vez de intentar
    # afinar el tracker a la perfección, se fusiona el ID nuevo con el vehículo ya contado
    # si aparece cerca (en tiempo y posición) de donde uno desapareció.
    frame_count = 0
    pos_contados = {}          # id contado y visible -> (xc, yc, último frame visto, cls, vx, vy)
    contados_desaparecidos = {}  # id contado que dejó de verse -> (xc, yc, frame, numero, cls, vx, vy)
    # valores ajustados según los switches reales observados en el log de debug
    # (huecos de hasta ~20 frames, deriva de posición de ~15-40px). Si se usan valores
    # más grandes (ej. 60/100) se corre el riesgo de fusionar vehículos DISTINTOS que
    # pasan por el mismo punto de la vía en un tiempo parecido (normal en tráfico fluido)
    # NOTA: comparar contra la ÚLTIMA posición fija fallaba con motos que encadenan
    # varios ID switches seguidos mientras siguen avanzando (una sola moto cruzando la
    # zona terminaba partida en 3-4 conteos porque a los ~15-20 frames ya se había
    # movido más de MERGE_DIST px). Se agrega velocidad (vx, vy) para predecir dónde
    # debería estar el vehículo ahora, en vez de asumir que sigue en el mismo punto.
    MERGE_WINDOW = 25   # frames de tolerancia
    MERGE_DIST = 50      # px de tolerancia entre la posición PREDICHA (con velocidad) y la nueva
    # Se probó reemplazar ByteTrack por BoT-SORT+ReID (compara apariencia visual, no solo
    # posición) para arreglar esto de raíz, pero el modo "auto" de ReID resultó demasiado
    # impreciso para autos (confundía autos distintos que se parecen -> el total cayó de
    # 35 a 18). Se revirtió a ByteTrack y en su lugar se amplía el margen SOLO para motos
    # (clase 3): en el log de debug se vio una moto real que se movió 62px en 18 frames,
    # por encima de MERGE_DIST=50 pero dentro de MERGE_WINDOW=25 -> con MERGE_DIST=50
    # fijo para todas las clases se hubiera tenido que aflojar también para autos, con
    # riesgo de fusionar autos distintos (como pasó con BoT-SORT+ReID).
    MERGE_DIST_MOTO = 75

    while cap.isOpened():
        status, frame = cap.read()
        if not status:
            break
        frame_count += 1

        frame = cv2.resize(frame, (w_out, h_out))
        # conf=0.4 filtra detecciones de baja confianza (falsos positivos)
        # agnostic_nms=True: sin esto, un mismo vehículo puede generar 2 cajas superpuestas
        # con clases distintas (ej. duda entre "car" y "truck"), cada una con su propio ID
        # -> se contaba 2 veces el mismo vehículo en el mismo instante
        # tracker="bytetrack_custom.yaml": las motos (pequeñas y rápidas) se movían más
        # que el 80% de solapamiento que exige el tracker por defecto entre frames ->
        # perdía el track y les daba un ID nuevo -> se contaban 3-4 veces
        results = model.predict(
            frame, classes=[2, 3, 5, 7], verbose=False,
            conf=0.4, agnostic_nms=True, imgsz=640
        ) # solo deteccion, el tracking (asociar IDs entre frames) lo hace OC-SORT aparte

        det_boxes = results[0].boxes.xyxy.cpu().numpy()
        det_conf = results[0].boxes.conf.cpu().numpy()
        det_cls = results[0].boxes.cls.cpu().numpy()
        if len(det_boxes) > 0:
            dets = np.concatenate([det_boxes, det_conf.reshape(-1, 1), det_cls.reshape(-1, 1)], axis=1)
        else:
            dets = np.empty((0, 6))

        es_moto = dets[:, 5] == 3
        dets_moto = dets[es_moto]
        dets_otros = dets[~es_moto]
        # hay que llamar a los dos trackers en CADA frame, incluso sin detecciones para ese grupo
        tracks_otros = byte_tracker.update(dets_otros, frame)
        tracks_moto = oc_tracker.update(dets_moto, frame)

        cv2.polylines(frame, [COORD_ZONA_A], True, (255, 0, 0), 2)

        boxes_list, ids_list, clses_list = [], [], []
        if len(tracks_otros) > 0:
            boxes_list.append(tracks_otros.xyxy)
            clses_list.append(tracks_otros.cls)
            ids_list.extend(("B", int(i)) for i in tracks_otros.id)  # prefijo para no chocar con IDs de OC-SORT
        if len(tracks_moto) > 0:
            boxes_list.append(tracks_moto.xyxy)
            clses_list.append(tracks_moto.cls)
            ids_list.extend(("M", int(i)) for i in tracks_moto.id)

        if ids_list:
            boxes = np.concatenate(boxes_list, axis=0)
            clses = np.concatenate(clses_list, axis=0)
            ids = ids_list
            nombres = results[0].names

            # se quitó la clasificación por tipo (car/bus/motorcycle/truck) del reporte:
            # solo se necesita el conteo total de objetos. La clase sí se usa internamente
            # para no fusionar por error un auto con una moto que pasó cerca al mismo tiempo.
            ids_vistos_este_frame = set()
            for box, id_obj, cls in zip(boxes, ids, clses):
                xmin, ymin, xmax, ymax = box
                xc, yc = int((xmin + xmax) / 2), int((ymin + ymax) / 2)

                zona_actual = None

                if path_a.contains_point((xc, yc)):
                    zona_actual = "Zona"

                    if id_obj in ids_contados_a:
                        prev = pos_contados.get(id_obj)
                        if prev is not None:
                            prev_x, prev_y, prev_frame, _prev_cls, _prev_vx, _prev_vy = prev
                            dt = frame_count - prev_frame
                            vx = (xc - prev_x) / dt if dt > 0 else 0
                            vy = (yc - prev_y) / dt if dt > 0 else 0
                        else:
                            vx, vy = 0, 0
                        pos_contados[id_obj] = (xc, yc, frame_count, cls, vx, vy)
                    else:
                        # ID nuevo dentro de la zona: ¿es continuación de un vehículo
                        # que el tracker "perdió" hace poco cerca de aquí? (típico en
                        # motos: caja angosta + movimiento rápido -> el tracker le
                        # asigna un ID nuevo al reaparecer). No se exige misma clase:
                        # el mismo vehículo a veces cambia de clase entre frames (por
                        # eso ya se usa agnostic_nms=True más arriba) -> exigirla
                        # bloqueaba fusiones legítimas (probado: subía el total de
                        # 35 a 45 al agregar esa restricción)
                        margen_dist = MERGE_DIST_MOTO if cls == 3 else MERGE_DIST
                        match_id = None
                        for old_id, (old_x, old_y, old_frame, _num, _old_cls, old_vx, old_vy) in contados_desaparecidos.items():
                            dt = frame_count - old_frame
                            pred_x = old_x + old_vx * dt
                            pred_y = old_y + old_vy * dt
                            if (dt <= MERGE_WINDOW
                                    and abs(xc - pred_x) < margen_dist
                                    and abs(yc - pred_y) < margen_dist):
                                match_id = old_id
                                break

                        ids_contados_a.add(id_obj)
                        if match_id is not None:
                            numero_contado[id_obj] = contados_desaparecidos[match_id][3]
                            # se hereda la velocidad del tramo anterior para poder seguir
                            # prediciendo si el tracker vuelve a cambiar de ID en cadena
                            vx_inicial, vy_inicial = contados_desaparecidos[match_id][5], contados_desaparecidos[match_id][6]
                            del contados_desaparecidos[match_id]
                        else:
                            total_contados += 1
                            numero_contado[id_obj] = total_contados
                            clase_contado[total_contados] = nombres[cls]
                            vx_inicial, vy_inicial = 0, 0

                        if cls == 3:  # DEBUG TEMPORAL comparativo con las pruebas anteriores (ByteTrack/BoT-SORT)
                            with open(os.path.join(ruta_base, "log_motos_ocsort.txt"), "a", encoding="utf-8") as f:
                                if match_id is not None:
                                    f.write(f"frame {frame_count} tracker_id {id_obj} -> FUSIONADO con conteo #{numero_contado[id_obj]} (pos {xc},{yc})\n")
                                else:
                                    f.write(f"frame {frame_count} tracker_id {id_obj} -> CONTADO NUEVO #{total_contados} (pos {xc},{yc})\n")

                        pos_contados[id_obj] = (xc, yc, frame_count, cls, vx_inicial, vy_inicial)

                    ids_vistos_este_frame.add(id_obj)

                if zona_actual:
                    # Mostrar número de conteo (no el ID crudo del tracker)
                    cv2.putText(
                        frame,
                        f"#{numero_contado[id_obj]} {clase_contado[numero_contado[id_obj]]}",
                        (int(xmin), int(ymin) - 10),
                        0, 0.55, (0, 255, 0), 2
                    )

            # vehículos contados que ya no aparecieron este frame -> "desaparecidos"
            # (se conservan por MERGE_WINDOW frames por si el tracker los recupera con ID nuevo)
            for old_id in list(pos_contados.keys()):
                if old_id not in ids_vistos_este_frame:
                    x, y, last_frame, cls, vx, vy = pos_contados.pop(old_id)
                    contados_desaparecidos[old_id] = (x, y, last_frame, numero_contado[old_id], cls, vx, vy)

        # --- HUD ---
        cv2.rectangle(frame, (10, 10), (200, 60), (255, 0, 0), -1)
        cv2.putText(frame, "ZONA", (20, 30), 0, 0.6, (255, 255, 255), 2)
        cv2.putText(frame, f"Total: {total_contados}", (20, 50), 0, 0.5, (255, 255, 255), 1)

        cv2.imshow("Zona Traffic Tracker", frame)
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

        video_writer.write(frame)

    cap.release()
    video_writer.release()
    cv2.destroyAllWindows()

    # --- RESUMEN FINAL ---
    total_vehiculos = total_contados
    desglose = {}
    for nombre_clase in clase_contado.values():
        desglose[nombre_clase] = desglose.get(nombre_clase, 0) + 1

    print(f"\n=== RESUMEN FINAL ===")
    print(f"Total de vehículos detectados: {total_vehiculos}")
    for nombre_clase, cantidad in desglose.items():
        print(f"  {nombre_clase}: {cantidad}")
    print(f"Resultados guardados en: {os.path.join(ruta_base, 'reporte_zonas_ocsort_TEST.csv')}")
    print(f"Video procesado guardado en: {os.path.join(ruta_base, 'resultado_procesado_ocsort_TEST.mp4')}")

    # Agregar resumen al CSV
    with open(os.path.join(ruta_base, "reporte_zonas_ocsort_TEST.csv"), mode="a", newline="") as csv_file:
        csv_writer = csv.writer(csv_file)
        csv_writer.writerow([])
        csv_writer.writerow(["RESUMEN"])
        csv_writer.writerow(["Tipo", "Cantidad"])
        for nombre_clase, cantidad in desglose.items():
            csv_writer.writerow([nombre_clase, cantidad])
        csv_writer.writerow(["Total", total_vehiculos])


def main():
    import argparse

    parser = argparse.ArgumentParser(description="Detecta y cuenta vehículos en una zona de un video usando YOLOv8.")
    parser.add_argument(
        "video_path",
        nargs="?",
        default="Video_TECmin.mp4",
        help="Ruta del video a procesar. Si no se especifica, usa Video_TECmin.mp4 en la carpeta del script.")
    args = parser.parse_args()
    detector(args.video_path)


if __name__ == "__main__":
    main()
