import cv2
import numpy as np
import matplotlib.path as mplPath
from ultralytics import YOLO
import csv
import os
import sys

# --- DEFINE LAS COORDENADAS DE LA ZONA ---
COORD_ZONA_A = np.array([
    [537, 312],
    [219, 511],
    [568, 713],
    [704, 483],
    [823, 351],
    [1088, 427],
    [918, 719],
    [700, 554],

], np.int32)

# --- CALIBRACIÓN ---

factor_escala = 1280 / 1920  # = 0.667
PIXELS_PER_METER = 77 * 0.667  # ≈ 7.7

def detector(video_path):
    ruta_base = os.path.dirname(os.path.abspath(__file__))
    video_full_path = video_path if os.path.isabs(video_path) else os.path.join(ruta_base, video_path)
    print(f"Abriendo video: {video_full_path}")
    model = YOLO("yolo11x.pt")
    cap = cv2.VideoCapture(video_full_path)
    if not cap.isOpened():
        raise FileNotFoundError(f"No se pudo abrir el video: {video_full_path}")

    fps = cap.get(cv2.CAP_PROP_FPS)
    w_out, h_out = 1280, 720

    video_writer = cv2.VideoWriter(
        os.path.join(ruta_base, "resultado_procesado.mp4"),
        cv2.VideoWriter_fourcc(*'mp4v'),
        fps, (w_out, h_out)
    )

    csv_file = open(os.path.join(ruta_base, "reporte_zonas.csv"), mode="w", newline="")
    csv_writer = csv.writer(csv_file)
    csv_writer.writerow(["Frame", "ID", "Clase", "Velocidad", "Zona"])

    path_a = mplPath.Path(COORD_ZONA_A)

    conteo_a = {'car': 0, 'bus': 0, 'motorcycle': 0, 'truck': 0}
    ids_contados_a = set()
    track_history = {}

    while cap.isOpened():
        status, frame = cap.read()
        if not status:
            break

        frame = cv2.resize(frame, (w_out, h_out))
        results = model.track(frame, persist=True, classes=[2, 3, 5, 7], verbose=False)

        cv2.polylines(frame, [COORD_ZONA_A], True, (255, 0, 0), 2)

        if results[0].boxes.id is not None:
            boxes = results[0].boxes.xyxy.cpu().numpy() #pasa del gpu al cpu y lo convierte a numpy
            ids = results[0].boxes.id.cpu().numpy().astype(int) #crea los ids que se van a contar, estan como decimales y se convierte en entero
            clases = results[0].boxes.cls.cpu().numpy().astype(int) #tipo de vehiculo/objeto es lo del COCO, se convierte en entero
            nombres = results[0].names #extrae los nombres de los objetos detectados

            for box, id_obj, cls_idx in zip(boxes, ids, clases):
                xmin, ymin, xmax, ymax = box
                etiqueta = nombres[cls_idx]
                xc, yc = int((xmin + xmax) / 2), int((ymin + ymax) / 2)

                zona_actual = None

                if path_a.contains_point((xc, yc)):
                    zona_actual = "Zona"
                    if id_obj not in ids_contados_a:
                        conteo_a[etiqueta] = conteo_a.get(etiqueta, 0) + 1
                        ids_contados_a.add(id_obj)

                if zona_actual:
                    if id_obj not in track_history:
                        track_history[id_obj] = {
                            'pos': (xc, yc),
                            'frame': cap.get(cv2.CAP_PROP_POS_FRAMES),
                            'speed': 0
                        }
                    else:
                        f_actual = cap.get(cv2.CAP_PROP_POS_FRAMES)
                        dif_f = f_actual - track_history[id_obj]['frame']
                        if dif_f >= 15:
                            dist = np.linalg.norm(
                                np.array((xc, yc)) - np.array(track_history[id_obj]['pos'])
                            )
                            speed = ((dist / PIXELS_PER_METER) / (dif_f / fps)) * 3.6
                            track_history[id_obj]['speed'] = round(speed, 1)
                            track_history[id_obj]['pos'] = (xc, yc)
                            track_history[id_obj]['frame'] = f_actual
                            csv_writer.writerow([int(f_actual), id_obj, etiqueta, speed, zona_actual])

                    # Mostrar ID + velocidad con color según rango
                    speed_display = track_history[id_obj].get('speed', 0)
                    color = (0, 255, 0) if speed_display < 60 else (0, 165, 255) if speed_display < 80 else (0, 0, 255)
                    cv2.putText(
                        frame,
                        f"ID:{id_obj} | {speed_display} km/h",
                        (int(xmin), int(ymin) - 10),
                        0, 0.55, color, 2
                    )

        # --- HUD ---
        cv2.rectangle(frame, (10, 10), (200, 120), (255, 0, 0), -1)
        cv2.putText(frame, "ZONA", (20, 30), 0, 0.6, (255, 255, 255), 2)
        for i, (k, v) in enumerate(conteo_a.items()):
            cv2.putText(frame, f"{k}: {v}", (20, 50 + (i * 15)), 0, 0.4, (255, 255, 255), 1)

        cv2.imshow("Zona Traffic Tracker", frame)
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

        video_writer.write(frame)

    cap.release()
    video_writer.release()
    csv_file.close()
    cv2.destroyAllWindows()

    # --- RESUMEN FINAL ---
    total_vehiculos = sum(conteo_a.values())
    print(f"\n=== RESUMEN FINAL ===")
    print(f"Total de vehículos detectados: {total_vehiculos}")
    for tipo, cantidad in conteo_a.items():
        print(f"{tipo.capitalize()}: {cantidad}")
    print(f"Resultados guardados en: {os.path.join(ruta_base, 'reporte_zonas.csv')}")
    print(f"Video procesado guardado en: {os.path.join(ruta_base, 'resultado_procesado.mp4')}")

    # Agregar resumen al CSV
    with open(os.path.join(ruta_base, "reporte_zonas.csv"), mode="a", newline="") as csv_file:
        csv_writer = csv.writer(csv_file)
        csv_writer.writerow([])
        csv_writer.writerow(["RESUMEN"])
        csv_writer.writerow(["Tipo", "Cantidad"])
        for tipo, cantidad in conteo_a.items():
            csv_writer.writerow([tipo, cantidad])
        csv_writer.writerow(["Total", total_vehiculos])


def main():
    import argparse

    parser = argparse.ArgumentParser(description="Detecta y cuenta vehículos en una zona de un video usando YOLOv8.")
    parser.add_argument(
        "video_path",
        nargs="?",
        default="Video_TECmin.mp4",
        help="Ruta del video a procesar. Si no se especifica, usa Video_TECmin.mp4 en la carpeta del script.")
    args = parser.parse_args()
    detector(args.video_path)


if __name__ == "__main__":
    main()
