import cv2 #abirir video
import numpy as np #matrices y operaciones matemáticas
import matplotlib.path as mplPath #ver si centroide está dentro de la zona de conteo
from ultralytics import YOLO #importar modelo de yolo
from boxmot.trackers.bbox.ocsort import OcSort #tracker unico para todas las clases
import csv #usar csv para reporte final
import os #abrir rutas de archivos
import sys # permitir que python acceda a los argumentos de los comandos

# --- DEFINE LAS COORDENADAS DE LA ZONA ---
COORD_ZONA_A = np.array([ #camibio a solo 1 punto de encuentro
    [400, 280],
    [750, 280],
    [1100, 450],
    [1100, 720],
    [600, 720],
    [300, 500],
], np.int32)

# --- ZONAS DE SALIDA: para saber hacia donde se va cada vehiculo ya contado ---
# (para futuro: saber direccion en la glorieta, no solo el total). Coordenadas
# confirmadas visualmente sobre un frame con cuadricula (layout_grid2.png) -- si
# se cambia el angulo de camara hay que revisar estas coordenadas de nuevo.
COORD_SALIDA_IZQUIERDA = np.array([  # da vuelta a la izquierda (ej. el taxi)
    [260, 370],
    [470, 370],
    [470, 500],
    [260, 500],
], np.int32)
COORD_SALIDA_CENTRO = np.array([  # sigue derecho hacia la camara
    [300, 560],
    [750, 560],
    [750, 720],
    [300, 720],
], np.int32)
COORD_SALIDA_DERECHA = np.array([  # la rampa curva con borde amarillo
    [880, 470],
    [1120, 470],
    [1120, 650],
    [880, 650],
], np.int32)

def detector(video_path):
    ruta_base = os.path.dirname(os.path.abspath(__file__))
    video_full_path = video_path if os.path.isabs(video_path) else os.path.join(ruta_base, video_path)
    print(f"Abriendo video: {video_full_path}")
    model = YOLO("yolo11x.pt") #CAMBIO A X PARA MEJOR PRECISIÓN
    cap = cv2.VideoCapture(video_full_path)
    if not cap.isOpened():
        raise FileNotFoundError(f"No se pudo abrir el video: {video_full_path}")

    fps = cap.get(cv2.CAP_PROP_FPS)
    w_out, h_out = 1280, 720 # si se le cambia acá rompe el video de dimensiones

    video_writer = cv2.VideoWriter(
        os.path.join(ruta_base, "resultado_procesado.mp4"),
        cv2.VideoWriter_fourcc(*'mp4v'),
        fps, (w_out, h_out)
    )

    # OC-SORT para TODAS las clases (car/bus/truck/motorcycle), por decision del
    # usuario. NOTA de tradeoff medido en pruebas: en este video, OC-SORT solo
    # (sin separar por clase) dio 2 motos / 12 autos / 1 bus (15 total), contra
    # 2 motos / 28 autos / 1 bus (31 total) usando ByteTrack para autos. Se aislo
    # la causa (no era ReID ni max_age): con trafico fluido de varios autos en el
    # mismo carril, la prediccion de Kalman de OC-SORT para un auto "perdido"
    # sigue viva varios frames y a veces un auto DISTINTO que pasa por ahi
    # cerca hereda ese mismo ID. Se opto por mantenerlo simple con un solo
    # tracker de todas formas.
    oc_tracker = OcSort(det_thresh=0.3, max_age=30, min_hits=1, iou_threshold=0.3)
    path_a = mplPath.Path(COORD_ZONA_A)
    path_salida_izquierda = mplPath.Path(COORD_SALIDA_IZQUIERDA)
    path_salida_centro = mplPath.Path(COORD_SALIDA_CENTRO)
    path_salida_derecha = mplPath.Path(COORD_SALIDA_DERECHA)
    direccion_contado = {}  # numero de conteo -> "izquierda"/"centro"/"derecha" (primera zona de salida donde se le ve)

    ids_contados_a = set()
    # el ID que da el tracker es global a todo el video (sube con cualquier
    # objeto detectado, entre o no a la zona); acá se guarda un número propio y
    # secuencial solo para los vehículos que sí entran a la zona, en orden de entrada
    numero_contado = {}
    total_contados = 0  # contador real de vehículos únicos (no cuenta los IDs fusionados)
    clase_contado = {}  # numero de conteo -> nombre de clase (car/motorcycle/truck/bus), para el desglose final

    # aun con OC-SORT, a veces se pierde un objeto por unos frames y se le da un
    # ID nuevo al reaparecer. Esta capa fusiona el ID nuevo con el vehículo ya
    # contado si aparece cerca (en tiempo y posición) de donde uno desapareció --
    # funciona como red de seguridad adicional sobre el tracker.
    frame_count = 0
    pos_contados = {}          # id contado y visible -> (xc, yc, último frame visto, cls, vx, vy)
    contados_desaparecidos = {}  # id contado que dejó de verse -> (xc, yc, frame, numero, cls, vx, vy)
    # valores ajustados según los switches reales observados en el log de debug
    # (huecos de hasta ~20 frames, deriva de posición de ~15-40px). Si se usan valores
    # más grandes (ej. 60/100) se corre el riesgo de fusionar vehículos DISTINTOS que
    # pasan por el mismo punto de la vía en un tiempo parecido (normal en tráfico fluido)
    # NOTA: comparar contra la ÚLTIMA posición fija fallaba con motos que encadenan
    # varios ID switches seguidos mientras siguen avanzando (una sola moto cruzando la
    # zona terminaba partida en varios conteos porque a los ~15-20 frames ya se había
    # movido más de MERGE_DIST px). Se agrega velocidad (vx, vy) para predecir dónde
    # debería estar el vehículo ahora, en vez de asumir que sigue en el mismo punto.
    MERGE_WINDOW = 25   # frames de tolerancia
    MERGE_DIST = 50      # px de tolerancia entre la posición PREDICHA (con velocidad) y la nueva
    MERGE_DIST_MOTO = 75  # margen mas amplio solo para motos (clase 3), que se mueven mas rapido
    # BUG encontrado analizando el video de 12 min: cuando 2+ autos DISTINTOS entran por
    # el mismo carril/punto en sucesion rapida, uno se "traga" el numero del otro. Se probo
    # primero exigir un hueco minimo (MERGE_WINDOW_MIN) pensando que era una condicion de
    # carrera con la recuperacion interna de OC-SORT -- medido y NO cambio nada (el hueco
    # real ya era >6 frames). La causa real: justo en la linea de entrada de la zona
    # (y=280) la velocidad calculada es casi cero (recien entra, casi no se ha movido), asi
    # que la posicion PREDICHA se queda "pegada" ahi sin importar cuantos frames pasen -- y
    # CUALQUIER auto nuevo que entre por ese mismo punto cae en esa posicion. Por eso se
    # excluye del match una franja pegada a la entrada (ENTRADA_Y_BUFFER), solo para
    # clases que no sean moto (las motos entran por otro punto y ya estan exentas).
    MERGE_WINDOW_MIN = 6  # frames minimos de ausencia antes de intentar fusionar
    ENTRADA_Y_BUFFER = 40  # px: un auto "desaparecido" muy cerca de la linea de entrada
                            # (y=280) no es candidato confiable para fusionar

    # Revision manual del video de 12 min encontro varios casos de doble conteo
    # REPARTIDOS por todo el video (no solo en la entrada), tanto en autos como
    # motos: el vehiculo se pierde por mas de MERGE_WINDOW (25 frames = 0.8s) y
    # reaparece con un ID nuevo sin fusionarse. Se probo primero un segundo intento
    # SOLO para motos con ventana larga + comparacion de color (huella HSV) -- pero
    # midiendolo, el color salio poco confiable incluso en pares que probablemente
    # SI eran el mismo vehiculo (correlaciones de 0.05 a 0.44, nunca pasaban el
    # umbral). Se cambia de estrategia: segunda oportunidad de fusion para TODAS
    # las clases, con ventana de tiempo mucho mas larga pero exigiendo posicion
    # MUY exacta (sin predecir por velocidad, que ya no es confiable en huecos
    # largos) -- razonamiento: a esa precision de posicion, es mucho mas probable
    # que sea el mismo vehiculo parado/lento que una coincidencia con uno distinto.
    MERGE_WINDOW_LARGO = 300   # frames (~10s a 30fps)
    MERGE_DIST_LARGO = 40      # px -- posicion estatica, sin prediccion de velocidad

    while cap.isOpened():
        status, frame = cap.read()
        if not status:
            break
        frame_count += 1

        frame = cv2.resize(frame, (w_out, h_out))
        # conf=0.4 filtra detecciones de baja confianza (falsos positivos)
        # agnostic_nms=True: sin esto, un mismo vehículo puede generar 2 cajas superpuestas
        # con clases distintas (ej. duda entre "car" y "truck"), cada una con su propio ID
        # -> se contaba 2 veces el mismo vehículo en el mismo instante
        results = model.predict(
            frame, classes=[2, 3, 5, 7], verbose=False,
            conf=0.4, agnostic_nms=True, imgsz=640
        ) # solo deteccion; el tracking (asociar IDs entre frames) lo hace OC-SORT aparte

        det_boxes = results[0].boxes.xyxy.cpu().numpy()
        det_conf = results[0].boxes.conf.cpu().numpy()
        det_cls = results[0].boxes.cls.cpu().numpy()
        if len(det_boxes) > 0:
            dets = np.concatenate([det_boxes, det_conf.reshape(-1, 1), det_cls.reshape(-1, 1)], axis=1)
        else:
            dets = np.empty((0, 6))

        tracks = oc_tracker.update(dets, frame)  # hay que llamarlo en CADA frame, incluso sin detecciones

        cv2.polylines(frame, [COORD_ZONA_A], True, (255, 0, 0), 2)
        cv2.polylines(frame, [COORD_SALIDA_IZQUIERDA], True, (0, 200, 0), 2)
        cv2.polylines(frame, [COORD_SALIDA_CENTRO], True, (0, 200, 0), 2)
        cv2.polylines(frame, [COORD_SALIDA_DERECHA], True, (0, 200, 0), 2)

        if len(tracks) > 0:
            boxes = tracks.xyxy
            ids = tracks.id
            clses = tracks.cls
            nombres = results[0].names

            # se quitó la clasificación por tipo (car/bus/motorcycle/truck) del reporte:
            # solo se necesita el conteo total de objetos. La clase sí se usa internamente
            # para no fusionar por error un auto con una moto que pasó cerca al mismo tiempo.
            ids_vistos_este_frame = set()
            for box, id_obj, cls in zip(boxes, ids, clses):
                xmin, ymin, xmax, ymax = box
                xc, yc = int((xmin + xmax) / 2), int((ymin + ymax) / 2)

                # registrar direccion de salida (solo para vehiculos ya contados, la
                # primera vez que se les ve en alguna de las 3 zonas de salida)
                if id_obj in ids_contados_a:
                    numero = numero_contado[id_obj]
                    if numero not in direccion_contado:
                        if path_salida_izquierda.contains_point((xc, yc)):
                            direccion_contado[numero] = "izquierda"
                        elif path_salida_centro.contains_point((xc, yc)):
                            direccion_contado[numero] = "centro"
                        elif path_salida_derecha.contains_point((xc, yc)):
                            direccion_contado[numero] = "derecha"

                zona_actual = None

                if path_a.contains_point((xc, yc)):
                    zona_actual = "Zona"

                    if id_obj in ids_contados_a:
                        # si este id habia quedado marcado "desaparecido" (por un solo
                        # frame sin verse, por ejemplo) pero en realidad sigue vivo -- se
                        # limpia esa entrada fantasma, si no queda disponible para que un
                        # vehiculo DISTINTO se fusione con el por error mas adelante
                        contados_desaparecidos.pop(id_obj, None)
                        prev = pos_contados.get(id_obj)
                        if prev is not None:
                            prev_x, prev_y, prev_frame, _prev_cls, _prev_vx, _prev_vy = prev
                            dt = frame_count - prev_frame
                            vx = (xc - prev_x) / dt if dt > 0 else 0
                            vy = (yc - prev_y) / dt if dt > 0 else 0
                        else:
                            vx, vy = 0, 0
                        pos_contados[id_obj] = (xc, yc, frame_count, cls, vx, vy)
                    else:
                        # ID nuevo dentro de la zona: ¿es continuación de un vehículo
                        # que el tracker "perdió" hace poco cerca de aquí? No se exige
                        # misma clase: el mismo vehículo a veces cambia de clase entre
                        # frames (por eso ya se usa agnostic_nms=True más arriba) ->
                        # exigirla bloqueaba fusiones legítimas (probado: subía el
                        # total de 35 a 45 al agregar esa restricción)
                        margen_dist = MERGE_DIST_MOTO if cls == 3 else MERGE_DIST
                        # las motos se pierden casi cada frame (necesitan fusionarse incluso
                        # con huecos de 1 frame) -> quedan exentas del minimo, que es
                        # especificamente para el caso de autos entrando muy seguidos
                        margen_window_min = 0 if cls == 3 else MERGE_WINDOW_MIN
                        match_id = None
                        for old_id, (old_x, old_y, old_frame, _num, _old_cls, old_vx, old_vy) in contados_desaparecidos.items():
                            # cerca de la linea de entrada (y=280) la posicion predicha no es
                            # confiable (ver nota arriba) -- se ignora como candidato, salvo motos
                            if cls != 3 and old_y < 280 + ENTRADA_Y_BUFFER:
                                continue
                            dt = frame_count - old_frame
                            pred_x = old_x + old_vx * dt
                            pred_y = old_y + old_vy * dt
                            if (margen_window_min <= dt <= MERGE_WINDOW
                                    and abs(xc - pred_x) < margen_dist
                                    and abs(yc - pred_y) < margen_dist):
                                match_id = old_id
                                break
                            # segunda oportunidad (todas las clases): hueco de tiempo mucho
                            # mas largo (hasta 10s), pero exigiendo posicion MUY exacta y
                            # ESTATICA (sin predecir por velocidad, que ya no es confiable a
                            # esa distancia de tiempo) -- a esa precision de posicion es muy
                            # poco probable que sea una coincidencia con un vehiculo distinto
                            if (dt <= MERGE_WINDOW_LARGO
                                    and abs(xc - old_x) < MERGE_DIST_LARGO
                                    and abs(yc - old_y) < MERGE_DIST_LARGO):
                                match_id = old_id
                                break

                        ids_contados_a.add(id_obj)
                        if match_id is not None:
                            numero_contado[id_obj] = contados_desaparecidos[match_id][3]
                            # se hereda la velocidad del tramo anterior para poder seguir
                            # prediciendo si el tracker vuelve a cambiar de ID en cadena
                            vx_inicial, vy_inicial = contados_desaparecidos[match_id][5], contados_desaparecidos[match_id][6]
                            del contados_desaparecidos[match_id]
                        else:
                            total_contados += 1
                            numero_contado[id_obj] = total_contados
                            clase_contado[total_contados] = nombres[cls]
                            vx_inicial, vy_inicial = 0, 0

                        pos_contados[id_obj] = (xc, yc, frame_count, cls, vx_inicial, vy_inicial)

                    ids_vistos_este_frame.add(id_obj)

                en_zona_salida = (id_obj in ids_contados_a
                                  and (path_salida_izquierda.contains_point((xc, yc))
                                       or path_salida_centro.contains_point((xc, yc))
                                       or path_salida_derecha.contains_point((xc, yc))))

                if zona_actual or en_zona_salida:
                    # Mostrar número de conteo (no el ID crudo del tracker), y la
                    # dirección de salida si ya se detectó
                    numero = numero_contado[id_obj]
                    etiqueta = f"#{numero} {clase_contado[numero]}"
                    if numero in direccion_contado:
                        etiqueta += f" -> {direccion_contado[numero]}"
                    cv2.putText(
                        frame, etiqueta,
                        (int(xmin), int(ymin) - 10),
                        0, 0.55, (0, 255, 0), 2
                    )

            # vehículos contados que ya no aparecieron este frame -> "desaparecidos"
            # (se conservan por MERGE_WINDOW frames por si el tracker los recupera con ID nuevo)
            for old_id in list(pos_contados.keys()):
                if old_id not in ids_vistos_este_frame:
                    x, y, last_frame, cls, vx, vy = pos_contados.pop(old_id)
                    contados_desaparecidos[old_id] = (x, y, last_frame, numero_contado[old_id], cls, vx, vy)

        # --- HUD ---
        segundos_transcurridos = int(frame_count / fps) if fps > 0 else 0
        tiempo_texto = f"{segundos_transcurridos // 60:02d}:{segundos_transcurridos % 60:02d}"

        cv2.rectangle(frame, (10, 10), (200, 80), (255, 0, 0), -1)
        cv2.putText(frame, "ZONA", (20, 30), 0, 0.6, (255, 255, 255), 2)
        cv2.putText(frame, f"Total: {total_contados}", (20, 50), 0, 0.5, (255, 255, 255), 1)
        cv2.putText(frame, f"Tiempo: {tiempo_texto}", (20, 70), 0, 0.5, (255, 255, 255), 1)

        cv2.imshow("Zona Traffic Tracker", frame)
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

        video_writer.write(frame)

    cap.release()
    video_writer.release()
    cv2.destroyAllWindows()

    # --- RESUMEN FINAL ---
    total_vehiculos = total_contados
    desglose = {}
    for nombre_clase in clase_contado.values():
        desglose[nombre_clase] = desglose.get(nombre_clase, 0) + 1

    desglose_direccion = {"izquierda": 0, "centro": 0, "derecha": 0, "sin registrar": 0}
    for numero in range(1, total_vehiculos + 1):
        desglose_direccion[direccion_contado.get(numero, "sin registrar")] += 1

    print(f"\n=== RESUMEN FINAL ===")
    print(f"Total de vehículos detectados: {total_vehiculos}")
    for nombre_clase, cantidad in desglose.items():
        print(f"  {nombre_clase}: {cantidad}")
    print("Direccion de salida:")
    for direccion, cantidad in desglose_direccion.items():
        print(f"  {direccion}: {cantidad}")
    print(f"Resultados guardados en: {os.path.join(ruta_base, 'reporte_zonas.csv')}")
    print(f"Video procesado guardado en: {os.path.join(ruta_base, 'resultado_procesado.mp4')}")

    # Agregar resumen al CSV
    with open(os.path.join(ruta_base, "reporte_zonas.csv"), mode="a", newline="") as csv_file:
        csv_writer = csv.writer(csv_file)
        csv_writer.writerow([])
        csv_writer.writerow(["RESUMEN"])
        csv_writer.writerow(["Tipo", "Cantidad"])
        for nombre_clase, cantidad in desglose.items():
            csv_writer.writerow([nombre_clase, cantidad])
        csv_writer.writerow(["Total", total_vehiculos])
        csv_writer.writerow([])
        csv_writer.writerow(["Direccion", "Cantidad"])
        for direccion, cantidad in desglose_direccion.items():
            csv_writer.writerow([direccion, cantidad])


def main():
    import argparse

    parser = argparse.ArgumentParser(description="Detecta y cuenta vehículos en una zona de un video usando YOLOv8.")
    parser.add_argument(
        "video_path",
        nargs="?",
        default="Video_TECmin.mp4",
        help="Ruta del video a procesar. Si no se especifica, usa Video_TECmin.mp4 en la carpeta del script.")
    args = parser.parse_args()
    detector(args.video_path)


if __name__ == "__main__":
    main()
